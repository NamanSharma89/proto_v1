{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Effect": "Allow",
			"Action": [
				"ec2:*",
				"rds:*",
				"s3:*",
				"ecr:*",
				"ecs:*",
				"elasticloadbalancing:*",
				"application-autoscaling:*",
				"cloudwatch:*",
				"logs:*",
				"sns:*",
				"secretsmanager:*",
				"sagemaker:*",
				"bedrock:*",
				"dynamodb:*",
				"route53:*",
				"ssm:GetParameter",
				"ssm:GetParameters",
				"ssm:DescribeParameters",
				"ssm:PutParameter",
				"ssm:AddTagsToResource",
				"ssm:RemoveTagsFromResource",
				"ssm:ListTagsForResource",
				"ssm:DeleteParameter"
			],
			"Resource": "*"
		},
		{
			"Effect": "Allow",
			"Action": [
				"iam:GetRole",
				"iam:CreateRole",
				"iam:DeleteRole",
				"iam:PutRolePolicy",
				"iam:AttachRolePolicy",
				"iam:DetachRolePolicy",
				"iam:DeleteRolePolicy",
				"iam:CreatePolicy",
				"iam:DeletePolicy",
				"iam:TagRole",
				"iam:ListRoleTags",
				"iam:GetServiceLinkedRoleDeletionStatus",
				"iam:ListAttachedRolePolicies",
				"iam:ListInstanceProfilesForRole",
				"iam:GetPolicy",
				"iam:GetPolicyVersion",
				"iam:ListPolicyVersions"
			],
			"Resource": "*"
		},
		{
			"Effect": "Allow",
			"Action": "iam:CreateServiceLinkedRole",
			"Resource": [
				"arn:aws:iam::817019235550:role/aws-service-role/ecs.amazonaws.com/AWSServiceRoleForECS",
				"arn:aws:iam::817019235550:role/aws-service-role/elasticloadbalancing.amazonaws.com/AWSServiceRoleForElasticLoadBalancing",
				"arn:aws:iam::817019235550:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS",
				"arn:aws:iam::817019235550:role/aws-service-role/bedrock.amazonaws.com/AWSServiceRoleForBedrock",
				"arn:aws:iam::817019235550:role/aws-service-role/sagemaker.amazonaws.com/AWSServiceRoleForSageMaker"
			],
			"Condition": {
				"StringLike": {
					"iam:AWSServiceName": [
						"ecs.amazonaws.com",
						"elasticloadbalancing.amazonaws.com",
						"rds.amazonaws.com",
						"bedrock.amazonaws.com",
						"sagemaker.amazonaws.com"
					]
				}
			}
		},
		{
			"Effect": "Allow",
			"Action": "iam:PassRole",
			"Resource": [
				"arn:aws:iam::817019235550:role/hdc-*-ecs-execution-role",
				"arn:aws:iam::817019235550:role/hdc-*-ecs-task-role",
				"arn:aws:iam::817019235550:role/hdc-*-bedrock-role",
				"arn:aws:iam::817019235550:role/hdc-*-sagemaker-role",
				"arn:aws:iam::817019235550:role/ecsTaskExecutionRole"
			],
			"Condition": {
				"StringEquals": {
					"iam:PassedToService": [
						"ecs.amazonaws.com",
						"ecs-tasks.amazonaws.com",
						"bedrock.amazonaws.com",
						"sagemaker.amazonaws.com",
						"lambda.amazonaws.com",
						"monitoring.rds.amazonaws.com"
					]
				}
			}
		}
	]
}